# MovieBox API Environment Configuration
PORT=3000

# Proxy Settings (Optional for Local, Recommended for Heroku/AWS/Vercel)
# Format: http://username:password@proxy_host:port
# SOCKS5: socks5://username:password@proxy_host:port
PROXY_URL=

# MongoDB Connection String (Atlas or Local)
# Example: mongodb+srv://username:password@cluster0.mongodb.net/moviebox_db?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=moviebox_db

# Admin User Email (Full access to Admin Panel to manage user plans)
ADMIN_EMAIL=nimeshmihiranga.doc@gmail.com

# GitHub OAuth Credentials (Optional - can also sign in directly via GitHub username)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public Base URL (Optional, auto-detected)
PUBLIC_URL=
